# BookRAG Configuration

# ==========================================
# LLM Provider Options
# ==========================================

# OPTION A: Groq API (Fast Cloud Inference) - RECOMMENDED
LLM_PROVIDER=openai
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
VISION_MODEL=llama-3.2-11b-vision-preview

# OPTION B: Local Ollama (Uncomment below to use Ollama instead of Groq)
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=hf.co/nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB:Q4_K_M
# VISION_MODEL=phi4-mini:latest

# ==========================================
# Embedding & Reranker Models
# ==========================================
# Default: Local SentenceTransformers (no external service needed)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Optional Superlinked SIE embeddings:
# EMBEDDING_BACKEND=sie
# SIE_EMBEDDINGS_URL=http://127.0.0.1:8080/v1/embeddings

# ==========================================
# Storage Paths
# ==========================================
DATA_DIR=data
IMAGES_DIR=data/images
PARENT_STORE_DIR=data/parent_store
CHROMA_PERSIST_DIR=data/chroma
BM25_PERSIST_DIR=data/bm25
OBSERVABILITY_DIR=data/observability

# ==========================================
# Chunking Parameters
# ==========================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ==========================================
# Supabase Persistence & Observability (Optional)
# ==========================================
# Run scripts/supabase_schema.sql and scripts/supabase_rag_schema.sql in Supabase SQL editor.
# STORAGE_BACKEND options: "local" (default), "supabase", or "auto"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here
SUPABASE_TABLE=observability_records
STORAGE_BACKEND=local

# ==========================================
# Admin Portal Credentials
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
