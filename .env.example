# BookRAG Configuration

# Local LLM served by Ollama. No OpenAI API key is used.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=hf.co/nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB:Q4_K_M
VISION_MODEL=phi4-mini:latest

# Embedding & Reranker Models
# SIE uses an OpenAI-compatible /v1/embeddings endpoint. Keep this model the
# same for indexing and searching; changing it requires re-indexing Chroma.
EMBEDDING_BACKEND=sie
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIE_EMBEDDINGS_URL=http://127.0.0.1:8080/v1/embeddings
RERANKER_MODEL=BAAI/bge-reranker-base

# Storage Paths
DATA_DIR=data
IMAGES_DIR=data/images
PARENT_STORE_DIR=data/parent_store
CHROMA_PERSIST_DIR=data/chroma
BM25_PERSIST_DIR=data/bm25

# Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Supabase Observability (optional)
# Create the table first by running scripts/supabase_schema.sql in the Supabase SQL editor.
# Use the service_role key here: it is only read server-side by Streamlit and never sent to browsers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here
SUPABASE_TABLE=observability_records

# Storage backend: auto (Supabase when configured, else local), local, or supabase
STORAGE_BACKEND=auto
